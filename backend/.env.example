# ============================================
# Qyron Backend Configuration
# ============================================

# Required: OpenRouter API key for AI responses
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI model to use via OpenRouter
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Frontend URL for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# Database URL (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./qyron.db

# JWT secret for authentication tokens (generate a strong random string for production)
JWT_SECRET=your_jwt_secret_here

# Environment: development or production
ENVIRONMENT=development

# Rate limits
GLOBAL_RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=20

# JWT token expiry in minutes (default: 7 days)
JWT_EXPIRY_MINUTES=10080
