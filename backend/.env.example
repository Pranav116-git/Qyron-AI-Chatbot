# ============================================
# Qyron Backend Configuration
# ============================================
# Copy this file to .env and fill in the values.

# --- AI Provider ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# --- Frontend URL (for CORS and redirects) ---
FRONTEND_URL=http://localhost:5173

# --- Database ---
# For local dev: sqlite+aiosqlite:///./qyron.db
# For production (Render): your postgres connection string from the provider
DATABASE_URL=sqlite+aiosqlite:///./qyron.db

# --- Security ---
# Generate a random secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=dev-secret-change-in-production

# --- Environment ---
# development | production
ENVIRONMENT=development

# --- Rate Limits ---
# Messages per minute per user
CHAT_RATE_LIMIT_PER_MINUTE=20
# Messages per day per user
CHAT_DAILY_LIMIT=200
# Auth attempts per window (login/register/forgot-password)
AUTH_RATE_LIMIT=10
# Auth rate window in seconds (default 5 minutes)
AUTH_RATE_WINDOW=300
# Global requests per minute per IP
GLOBAL_RATE_LIMIT_PER_MINUTE=120

# --- SMTP (optional, for password reset emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
